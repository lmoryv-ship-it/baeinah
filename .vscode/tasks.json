{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "▶ تشغيل المشروع (dev)",
            "type": "shell",
            "command": "npm run dev",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "."
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "بَيِّنة تعمل على المنفذ"
                }
            }
        },
        {
            "label": "📦 تثبيت المكتبات",
            "type": "shell",
            "command": "npm install",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "📋 نسخ ملف البيئة",
            "type": "shell",
            "command": "cp .env.example .env && echo '✅ تم إنشاء .env — أضف مفاتيحك الآن'",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "windows": {
                "command": "copy .env.example .env"
            }
        },
        {
            "label": "🐳 Docker: تشغيل",
            "type": "shell",
            "command": "docker compose up -d",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "🐳 Docker: إيقاف",
            "type": "shell",
            "command": "docker compose down",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "🐳 Docker: سجلات",
            "type": "shell",
            "command": "docker compose logs -f app",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "🔑 توليد JWT_SECRET",
            "type": "shell",
            "command": "node -e \"console.log('JWT_SECRET=' + require('crypto').randomBytes(64).toString('hex'))\"",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
