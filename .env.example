# ── بَيِّنة — متغيرات البيئة ──────────────────────────────
# انسخ هذا الملف إلى .env وعدّل القيم وفق بيئتك

# ── الخادم ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
BASE_URL=https://baeinah.sa

# ── قاعدة البيانات (SQLite) ───────────────────────────────
DB_PATH=./data/baeinah.db

# ── رفع الملفات ───────────────────────────────────────────
UPLOAD_DIR=./uploads

# ── المصادقة JWT ──────────────────────────────────────────
# استخدم: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_64_CHAR_RANDOM_SECRET
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES=30d

# ── Google Gemini AI ──────────────────────────────────────
# احصل على المفتاح من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── بوابة الدفع ميسر ─────────────────────────────────────
# احصل على المفاتيح من: https://dashboard.moyasar.com/
MOYASAR_API_KEY=moyasar_publishable_key_here
MOYASAR_SECRET_KEY=moyasar_secret_key_here

# ── المسؤول (يُنشئ تلقائياً عند أول تشغيل) ───────────────
ADMIN_EMAIL=admin@baeinah.sa
ADMIN_PASSWORD=change_this_strong_password
