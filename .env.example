# ══════════════════════════════════════════════
#  بَيِّنة — متغيرات البيئة
#  انسخ هذا الملف إلى .env وعدّل القيم
# ══════════════════════════════════════════════

# ── الخادم ─────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ── قاعدة البيانات ──────────────────────────────
DB_PATH=./data/baeinah.db

# ── الأمان (استخدم قيماً عشوائية طويلة في الإنتاج) ──
# أنشئ سراً قوياً: openssl rand -hex 64
JWT_SECRET=change_this_to_a_strong_random_secret_64_chars_min
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES=30d

# ── Google Gemini AI ───────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ── Moyasar — بوابة الدفع ──────────────────────
# احصل على مفاتيحك من: https://dashboard.moyasar.com
MOYASAR_API_KEY=sk_test_your_moyasar_key_here
MOYASAR_PUBLISHABLE_KEY=pk_test_your_moyasar_publishable_key_here

# ── رفع الملفات ─────────────────────────────────
UPLOAD_DIR=./uploads
